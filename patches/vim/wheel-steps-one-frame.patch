+/*
+ * After a mouse wheel step, before drawing the screen: return TRUE when a key
+ * comes before a frame (16 msec) has passed since the screen was drawn after
+ * one, then it is drawn once for both.  A touchpad sends a step every 7 msec
+ * (Konsole): the screen drawn for each, more often than a terminal shows it,
+ * moved by uneven jumps.  The first step after a pause is drawn at once.
+ */
+    int
+mouse_scroll_wait(void)
+{
+#ifdef ELAPSED_FUNC
+    static elapsed_T	drawn;
+    static int		drawn_set = FALSE;
+    long		left;
+
+    if (!mouse_scrolled)
+	return FALSE;
+    mouse_scrolled = FALSE;
+    if (drawn_set)
+	for (left = 16 - ELAPSED_FUNC(drawn); left > 0;
+					     left = 16 - ELAPSED_FUNC(drawn))
+	{
+	    if (char_avail())
+		return TRUE;
+	    ui_delay(left < 2 ? left : 2, TRUE);
+	}
+    ELAPSED_INIT(drawn);
+    drawn_set = TRUE;
+#endif
+    return FALSE;
+}
